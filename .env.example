DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Neon (or any Postgres host) connection string. Leave unset for local
# SQLite. Get this from the Neon dashboard -> your project -> Connection
# Details -> "Pooled connection" string. Keep ?sslmode=require in it.
# DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
